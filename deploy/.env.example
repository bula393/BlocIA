# Required for the Dokploy compose file. Use the SHA tag published by CI.
GHCR_IMAGE_PREFIX=ghcr.io/your-github-owner/blocia
RELEASE_TAG=0000000000000000000000000000000000000000
FRONTEND_URL=https://blocia.example.com

# Generate separate random secrets before deployment; never commit real values.
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
BLOCIA_INFERENCE_TOKEN=replace-with-a-different-long-random-secret

# Required by deploy/dokploy.compose.yaml; use a URL-safe random value.
POSTGRES_DB=blocia
POSTGRES_USER=blocia
POSTGRES_PASSWORD=replace-with-a-long-url-safe-random-secret

# PostgreSQL data lives in its dedicated database volume; models live in inference storage.
BLOCIA_LOCK_MINUTES=1440
BLOCIA_ENABLE_LOCAL_CHAT=0
BLOCIA_PREPARE_MODELS=1
BLOCIA_INFERENCE_TIMEOUT_SECONDS=300
INFERENCE_CPUS=2.0
INFERENCE_CPU_THREADS=2
INFERENCE_MEMORY_LIMIT=6g
API_CPUS=1.0
API_MEMORY_LIMIT=512m

# Optional server provider credentials. Each user's own token takes priority.
BLOCIA_DEFAULT_GOOGLE_TOKEN=
BLOCIA_DEFAULT_GROQ_TOKEN=
BLOCIA_DEFAULT_OPENROUTER_TOKEN=
BLOCIA_DEFAULT_OPENAI_TOKEN=
BLOCIA_DEFAULT_ANTHROPIC_TOKEN=

# Required by production PostgreSQL deployments. Generate with Fernet.generate_key().
# Leave blank only for local SQLite development, where the key is stored in the data volume.
BLOCIA_ENCRYPTION_KEY=

# Optional Google login. Set the redirect URL to the exact public API callback.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://blocia.example.com/api/auth/google/callback
GOOGLE_SESSION_SECRET=
GOOGLE_REGISTRATION_SECRET=

# Local compose: set FRONTEND_URL=http://localhost:8080 and FRONTEND_PORT=8080.
FRONTEND_PORT=8080
