# Paste these values only into the frontend resource's Dokploy Environment tab.
GHCR_IMAGE_PREFIX=ghcr.io/your-github-owner/blocia
RELEASE_TAG=0000000000000000000000000000000000000000

# Match the API and inference resources on the same server.
BLOCIA_NETWORK_NAME=blocia-production
BLOCIA_SERVICE_NAMESPACE=blocia-prod

# Configure the HTTPS domain in Dokploy for service frontend, port 8080.
FRONTEND_CPUS=0.5
FRONTEND_MEMORY_LIMIT=128m
