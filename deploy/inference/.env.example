# Paste these values only into the inference resource's Dokploy Environment tab.
GHCR_IMAGE_PREFIX=ghcr.io/your-github-owner/blocia
RELEASE_TAG=0000000000000000000000000000000000000000

# Match the frontend and API resources on the same server.
BLOCIA_NETWORK_NAME=blocia-production
BLOCIA_SERVICE_NAMESPACE=blocia-prod

# Use exactly the same token configured in the API resource.
BLOCIA_INFERENCE_TOKEN=replace-with-a-different-long-random-secret

# Leave blank for a new namespace-derived volume, or set an existing model volume.
BLOCIA_MODELS_VOLUME_NAME=
BLOCIA_ENABLE_LOCAL_CHAT=0
BLOCIA_PREPARE_MODELS=1
INFERENCE_CPUS=2.0
INFERENCE_CPU_THREADS=2
INFERENCE_MEMORY_LIMIT=6g
