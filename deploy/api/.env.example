# Paste these values only into the API resource's Dokploy Environment tab.
GHCR_IMAGE_PREFIX=ghcr.io/your-github-owner/blocia
RELEASE_TAG=0000000000000000000000000000000000000000
FRONTEND_URL=https://blocia.example.com

# Match the frontend and inference resources on the same server.
BLOCIA_NETWORK_NAME=blocia-production
BLOCIA_SERVICE_NAMESPACE=blocia-prod

# Generate a unique session secret. The inference token must match inference.
ACCESS_TOKEN_SECRET=replace-with-a-long-random-secret
BLOCIA_INFERENCE_TOKEN=replace-with-a-different-long-random-secret

# Leave blank for a new namespace-derived volume. To preserve existing data,
# use the complete existing volume name after stopping its previous API writer.
BLOCIA_API_VOLUME_NAME=
BLOCIA_LOCK_MINUTES=1440
BLOCIA_INFERENCE_TIMEOUT_SECONDS=300
API_CPUS=1.0
API_MEMORY_LIMIT=512m

# Optional server AI credentials. Each user's own token takes priority.
BLOCIA_DEFAULT_GOOGLE_TOKEN=
BLOCIA_DEFAULT_GROQ_TOKEN=
BLOCIA_DEFAULT_OPENROUTER_TOKEN=
BLOCIA_DEFAULT_OPENAI_TOKEN=
BLOCIA_DEFAULT_ANTHROPIC_TOKEN=

# Optional Fernet key. If absent, one is created inside the persistent API volume.
BLOCIA_ENCRYPTION_KEY=

# Optional Google login. Register this exact public callback in Google OAuth.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://blocia.example.com/api/auth/google/callback
GOOGLE_SESSION_SECRET=
GOOGLE_REGISTRATION_SECRET=
