# Tokens globales del servidor; completá sólo los proveedores que quieras habilitar.
# Las claves personales de cada usuario tienen prioridad sobre estos valores.
BLOCIA_DEFAULT_GOOGLE_TOKEN=
BLOCIA_DEFAULT_GROQ_TOKEN=
BLOCIA_DEFAULT_OPENROUTER_TOKEN=
BLOCIA_DEFAULT_OPENAI_TOKEN=
BLOCIA_DEFAULT_ANTHROPIC_TOKEN=

# Duración del bloqueo por límite de uso, en minutos (entero positivo; 1440 = 24 horas).
BLOCIA_LOCK_MINUTES=1440

# Registro local de cuotas Google verificadas en AI Studio (vinculado a la clave).
# Ruta predeterminada: back/data/google-model-access.json. Actualizar al cambiar proyecto/plan/clave.
# BLOCIA_GOOGLE_MODEL_ACCESS_PATH=
