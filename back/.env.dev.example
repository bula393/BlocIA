# Tokens globales del servidor; completá sólo los proveedores que quieras habilitar.
# Las claves personales de cada usuario tienen prioridad sobre estos valores.
BLOCIA_DEFAULT_GOOGLE_TOKEN=
BLOCIA_DEFAULT_GROQ_TOKEN=
BLOCIA_DEFAULT_OPENROUTER_TOKEN=
BLOCIA_DEFAULT_OPENAI_TOKEN=
BLOCIA_DEFAULT_ANTHROPIC_TOKEN=

# Duración del bloqueo por límite de uso, en minutos (entero positivo; 1440 = 24 horas).
BLOCIA_LOCK_MINUTES=1
BLOCIA_REGISTRATION_MAX_PER_DAY=500
BLOCIA_MAX_ACCOUNTS=100000
BLOCIA_VERIFICATION_EMAIL_MAX_PER_DAY=250
BLOCIA_CLASSIFICATION_MAX_PER_USER_PER_DAY=50
BLOCIA_CLASSIFICATION_MAX_PER_DAY=5000
BLOCIA_SHARED_PROVIDER_MAX_PER_DAY=300

# Registro local de cuotas Google verificadas en AI Studio (vinculado a la clave).
# Ruta predeterminada: back/data/google-model-access.json. Actualizar al cambiar proyecto/plan/clave.
# BLOCIA_GOOGLE_MODEL_ACCESS_PATH=

# Acceso con Google OAuth: credenciales de Aplicación web de Google Cloud.
# Son independientes de BLOCIA_DEFAULT_GOOGLE_TOKEN (clave del modelo Gemini).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_SESSION_SECRET=
# Optional override; if empty, the API derives a purpose-specific key from ACCESS_TOKEN_SECRET.
GOOGLE_REGISTRATION_SECRET=

# Cuenta Google para Gemini (independiente del login). Crear otro cliente OAuth web.
# Mantener deshabilitado hasta configurar y probar las credenciales.
BLOCIA_GOOGLE_OAUTH_ENABLED=0
GOOGLE_AI_CLIENT_ID=
GOOGLE_AI_CLIENT_SECRET=
GOOGLE_AI_REDIRECT_URI=http://localhost:5173/api/technical-profile/google/callback
# En Dokploy: GOOGLE_REDIRECT_URI=https://bloqia.policloudservices.ipm.edu.ar/api/auth/google/callback

# Verificación por correo antes de guardar claves propias. ACCESS_TOKEN_SECRET >= 32 caracteres.
ACCESS_TOKEN_SECRET=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
